  "scripts": {
    "lint:fix": "prettier */*.js \"*/**/*{.js,.ts}\" -w",
    "lint": "prettier */*.js \"*/**/*{.js,.ts}\" --check",
    "test:unit": "cd programs/blindside && SDKROOT=${SDKROOT:-/Library/Developer/CommandLineTools/SDKs/MacOSX26.sdk} cargo test --lib",
    "test:devnet": "ts-mocha -p ./tsconfig.json -t 1000000 tests/blindside.ts",
    "typecheck": "tsc --noEmit -p .",
    "sync-idl": "cp target/idl/blindside.json ../packages/client/src/idl/blindside.json && cp target/types/blindside.ts ../packages/client/src/idl/blindside.ts",
    "build": "SDKROOT=${SDKROOT:-/Library/Developer/CommandLineTools/SDKs/MacOSX26.sdk} anchor build && pnpm sync-idl"
  },
  "dependencies": {
    "@coral-xyz/anchor": "0.32.1",
    "@magicblock-labs/ephemeral-rollups-sdk": "0.18.0",
    "@solana/spl-token": "0.4.9",
    "@solana/web3.js": "1.98.4",
    "tweetnacl": "1.0.3",
    "@blindside/client": "workspace:*"
  },
  "devDependencies": {
    "@types/bn.js": "5.2.0",
    "@types/chai": "4.3.20",
    "@types/mocha": "9.1.1",
    "@types/node": "22.20.5",
    "chai": "4.5.0",
    "mocha": "9.2.2",
    "prettier": "2.8.8",
    "ts-mocha": "10.1.0",
    "tsx": "4.23.15",
    "typescript": "5.9.3"
  },
  "name": "@blindside/program"
}
